# Откуда брать журнал: публичная ссылка Яндекс.Диска + локальный кэш.
JOURNAL_SOURCE=yandex-public-cache

# Список групп. Одна строка (или элемент через запятую) = одна группа.
# Форматы записи:
#   https://disk.yandex.ru/i/ССЫЛКА                — группа, имя берётся из имени файла
#   ИСиП-25/9 = https://disk.yandex.ru/i/ССЫЛКА    — группа со своим названием
#   https://disk.yandex.ru/d/ССЫЛКА                — ссылка на ПАПКУ: каждый Excel внутри станет группой
YANDEX_DISK_PUBLIC_URLS=https://disk.yandex.ru/i/jr0lr00cUQp0FQ,https://disk.yandex.ru/i/QZZ5ghsJ_w7xAg,https://disk.yandex.ru/i/ezTOIqg1oAictA

# Старый вариант на одну группу. Работает, только если YANDEX_DISK_PUBLIC_URLS не задан.
# YANDEX_DISK_PUBLIC_URL=https://disk.yandex.ru/i/jr0lr00cUQp0FQ
# YANDEX_DISK_PUBLIC_PATH=

# Кэш: как часто перекачивать файлы и сколько копий хранить на каждую группу.
JOURNAL_CACHE_INTERVAL_MINUTES=30
JOURNAL_CACHE_MAX_FILES=2
JOURNAL_CACHE_DIR=./.journal-cache

# Окно обновления по местному времени (вне окна отдаётся последняя скачанная копия).
JOURNAL_REFRESH_FROM_HOUR=5
JOURNAL_REFRESH_TO_HOUR=24
JOURNAL_TIMEZONE_OFFSET_HOURS=5

# Сколько разобранных журналов держать в памяти (по умолчанию 4).
# JOURNAL_PARSED_CACHE_SIZE=4

# Телеграм-бот (не коммитить реальный токен).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
