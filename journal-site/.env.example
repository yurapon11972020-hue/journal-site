# Серверный источник журнала.
# Пока коды доступа не заданы, журнал открыт всем, у кого есть адрес.
# Как только задан хотя бы один код, вход по коду становится обязательным.
JOURNAL_SOURCE=yandex-public-cache
YANDEX_DISK_PUBLIC_URLS=https://disk.yandex.ru/i/jr0lr00cUQp0FQ,https://disk.yandex.ru/i/QZZ5ghsJ_w7xAg,https://disk.yandex.ru/i/ezTOIqg1oAictA
# Формат списка: Название группы = https://disk.yandex.ru/i/ВАША_ССЫЛКА
# Разделители: запятая, точка с запятой, новая строка.
# Ссылка /d/... на папку: каждый Excel внутри становится группой.
# Локальный режим: JOURNAL_SOURCE=local и JOURNAL_LOCAL_PATH=./data/journal.xlsx
# Можно использовать JOURNAL_LOCAL_FOLDER=./data для нескольких групп.
# Приватный режим: JOURNAL_SOURCE=yandex-private, YANDEX_DISK_PATH, YANDEX_DISK_OAUTH_TOKEN.

# Разные коды для разных групп. Ключ — точное отображаемое имя или ID группы.
# Минимум 8 символов; используйте случайные коды от 16 символов.
JOURNAL_GROUP_ACCESS_CODES={}
# Старый код поддерживается только при единственной настроенной группе.
# JOURNAL_ACCESS_CODE=
# Операторский код, минимум 16 символов, даёт доступ ко всем группам.
# JOURNAL_ADMIN_CODE=
# Случайный отдельный секрет подписи сессии (рекомендуется 32+ символа).
JOURNAL_SESSION_SECRET=
# В production задайте фактический https-адрес этого сайта, без пути.
PUBLIC_SITE_URL=

JOURNAL_CACHE_INTERVAL_MINUTES=30
JOURNAL_CACHE_MAX_FILES=2
JOURNAL_CACHE_DIR=./.journal-cache
JOURNAL_PARSED_CACHE_SIZE=4
JOURNAL_REFRESH_FROM_HOUR=5
JOURNAL_REFRESH_TO_HOUR=24
JOURNAL_TIMEZONE_OFFSET_HOURS=5

# Задавайте только если учебный год известен. Без него парсер не выдумывает год.
# Например, для 2026/2027: JOURNAL_ACADEMIC_YEAR_START=2026
# JOURNAL_DEBUG=true

# Бот выключен, пока не настроены секрет и разрешённые личные чаты.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_GROUP_ACCESS={"123456789":"Точное название группы"}
