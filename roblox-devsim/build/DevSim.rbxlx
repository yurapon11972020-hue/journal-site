local function hudLabel(yoff, h, color)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Position = UDim2.new(0, 0, 0, yoff)
    t.Size = UDim2.new(1, 0, 0, h)
    t.Font = FONT
    t.TextScaled = true
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextColor3 = color
    t.Parent = hud
    tstroke(t, 2)
    return t
end
