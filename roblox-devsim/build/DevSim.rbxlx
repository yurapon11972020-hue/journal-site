hud.Size = UDim2.new(0, 340, 0, 172)
hud.Position = UDim2.new(0, 16, 0, 16)
hud.BackgroundColor3 = PANEL
hud.Parent = gui
corner(hud, 20)
stroke(hud, ACCENT, 3)
local hpad = Instance.new("UIPadding")
