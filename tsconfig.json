# Пример переменных окружения.
# Скопируй этот файл в .env.local для локального запуска:
#   cp .env.example .env.local   (или create копию вручную на Windows)
#
# Реальные значения для Render задаются в render.yaml или в настройках сервиса,
# а не в этом файле.

# Текущий режим: публичная ссылка Яндекс.Диска без OAuth-токена + локальный кэш.
JOURNAL_SOURCE=yandex-public-cache
YANDEX_DISK_PUBLIC_URL=https://disk.yandex.ru/i/sGTYC8nUWYAsRw
YANDEX_DISK_PUBLIC_PATH=
JOURNAL_CACHE_INTERVAL_MINUTES=30
JOURNAL_CACHE_MAX_FILES=2
JOURNAL_CACHE_DIR=./.journal-cache

# --- Телеграм-бот ---
# Токен от @BotFather. Обязателен, чтобы работал бот.
TELEGRAM_BOT_TOKEN=
# Необязательный секрет для защиты webhook (любая случайная строка).
TELEGRAM_WEBHOOK_SECRET=

# --- Альтернативные режимы (не нужны для текущей ссылки) ---

# Только локальный Excel-файл, без интернета:
# JOURNAL_SOURCE=local
# JOURNAL_LOCAL_PATH=./data/journal.xlsx

# Приватный Яндекс.Диск с OAuth-токеном:
# JOURNAL_SOURCE=yandex-private
# YANDEX_DISK_OAUTH_TOKEN=твой_токен
# YANDEX_DISK_PATH=disk:/путь/к/файлу.xlsx
